# ============================================================
# Production .env (lives on the droplet at ~/premium-gadget/.env — never commit)
# Every blank value below must be filled in. Generate secrets with:
#   openssl rand -hex 32
# The API refuses to start in production with missing/placeholder secrets.
# Use hex/URL-safe values for POSTGRES_PASSWORD (it is embedded in a URL).
# ============================================================

# ─── PostgreSQL ──────────────────────────────────────
POSTGRES_USER=premium_gadget
POSTGRES_PASSWORD=
POSTGRES_DB=premium_gadget

# ─── Backend ─────────────────────────────────────────
NODE_ENV=production
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_STAFF_EXPIRES_IN=12h
# Storefront domain(s) + the local admin app origin (comma-separated, no trailing slash)
CORS_ORIGIN=https://premiumgadget.com.bd,http://localhost:5173
# Proxy hops in front of the API: Caddy only = 1, Cloudflare (orange cloud) → Caddy = 2
TRUST_PROXY=1
# Only with Cloudflare proxy: Cloudflare IP ranges, space-separated (see deploy/Caddyfile)
TRUSTED_PROXIES=private_ranges
# Shared secret the storefront's server-side fetches send as X-Internal-Key
# (exempts SSR from per-IP rate limits). Set the same value on Vercel.
INTERNAL_API_KEY=
# Max % below list price a branch_admin may sell at in POS (super_admin uncapped)
POS_MAX_STAFF_DISCOUNT_PCT=10

# ─── Public URLs ─────────────────────────────────────
API_DOMAIN=api.premiumgadget.com.bd
SERVER_PUBLIC_URL=https://api.premiumgadget.com.bd/api/v1
STOREFRONT_URL=https://premiumgadget.com.bd
STOREFRONT_REVALIDATE_URL=
REVALIDATE_SECRET=

# ─── SSLCommerz ──────────────────────────────────────
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# true while testing; MUST be false for real customers (sandbox "payments" are fake)
SSLCOMMERZ_IS_SANDBOX=true
# Production refuses to start with sandbox payments unless this is true (pre-launch testing only)
ALLOW_SANDBOX_IN_PRODUCTION=false

# ─── Cloudflare R2 (product images + off-site DB backups) ─
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=premium-gadget-media
# Public bucket URL (r2.dev subdomain or custom domain like https://media.premiumgadget.com.bd)
R2_PUBLIC_BASE_URL=
# Private bucket for database backups (optional, recommended)
R2_BACKUP_BUCKET=

# ─── SMS gateway (OTP / password reset) ──────────────
SMS_API_KEY=
SMS_SENDER_ID=PremiumGadget
