# ─── Backend env for running the API directly on your machine (npm run dev) ───
# In Docker, the root .env + docker-compose*.yml provide these instead.
NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://premium_gadget:change_me@localhost:5433/premium_gadget

# Min 32 random chars (openssl rand -hex 32). In development a missing/weak
# secret falls back to an ephemeral one (sessions reset on restart).
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_STAFF_EXPIRES_IN=12h

# Storefront dev server + local admin app
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

SERVER_PUBLIC_URL=http://localhost:5000/api/v1
STOREFRONT_URL=http://localhost:3000

SSLCOMMERZ_STORE_ID=your_sandbox_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sandbox_store_password
SSLCOMMERZ_IS_SANDBOX=true

# Images: "local" writes to backend/uploads (dev only). Set the R2_* vars to use Cloudflare R2.
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

SMS_API_KEY=
SMS_SENDER_ID=PremiumGadget

# Instant storefront refresh after admin edits (optional). The secret must match
# the storefront's REVALIDATE_SECRET (16+ random characters).
STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=
