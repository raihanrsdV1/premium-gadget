NEXT_PUBLIC_API_BASE_URL=http://localhost:5001/api/v1
# Public site origin (canonical URLs, sitemap, JSON-LD). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only (no NEXT_PUBLIC_ prefix): must match the API's INTERNAL_API_KEY.
INTERNAL_API_KEY=

# Server-only: shared secret for POST /api/revalidate (on-demand cache refresh
# after admin edits). Must match the API's REVALIDATE_SECRET; at least 16
# characters (e.g. `openssl rand -hex 32`). Leave empty to disable the hook.
REVALIDATE_SECRET=
